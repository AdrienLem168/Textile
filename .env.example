# Copier en .env et renseigner une clé API Mistral (https://console.mistral.ai/)
MISTRAL_API_KEY=

# Optionnel : bibliothèque de documents Mistral où publier le rapport
# (créée via l'API ou Studio ; sinon définir library_id dans l'input du workflow)
REPORT_LIBRARY_ID=

# Destinataire de l'e-mail hebdomadaire (défaut : adrien.lemaitre@ademe.fr)
REPORT_EMAIL_RECIPIENT=
